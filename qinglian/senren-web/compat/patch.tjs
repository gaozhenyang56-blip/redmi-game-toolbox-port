Plugins.link("motionplayer.dll");
if(typeof Motion.D3DAdaptor == "undefined") {
	with(Motion.Player) { .useD3D = 0; }
} else {
	&Motion.Player.useD3D = 0;
}
System.setArgument("-hdresomode", "1080");
Window.movieQualitySelectMenuItem = %[
	"children" => %[
	]
];


// Web port: use the bundled Simplified Chinese localization.
try {
 Plugins.link("krkrsteam.dll");
 Steam.getLanguage = function() { return "schinese"; };
 Debug.message("[port] Simplified Chinese selected");
} catch(e) { Debug.message("[port] Language setup: " + e.message); }
