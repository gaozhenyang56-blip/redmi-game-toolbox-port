[Unit]
Description=DeepSeek Harness Web UI
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/srv/dsh-workspace
Environment=HOME=/var/lib/dsh
Environment=DSH_HOME=/var/lib/dsh
Environment=PATH=/opt/dsh/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/dsh/launch.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsh /srv/dsh-workspace
UMask=0077
MemoryHigh=512M
MemoryMax=768M
TasksMax=256
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
